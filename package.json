{
  "name": "grok-desk-paper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paper-only Solana memecoin trading desk PWA. Fake money, live public market data. No wallet, no keys.",
  "scripts": {
    "test": "node --test tests/*.mjs",
    "collect": "node runner/collect-ohlcv.mjs",
    "eval": "node runner/walkforward.mjs",
    "paper": "node runner/headless.mjs --minutes 60 --out runner/state.json",
    "record": "node runner/headless.mjs --minutes 60 --out runner/session-state.json --tape replay/tape.json",
    "replay-check": "node runner/replay-check.mjs",
    "serve": "python3 -m http.server 8765"
  }
}
